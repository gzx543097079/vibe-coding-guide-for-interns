  "narrative": {
    "northStar": "一张表看全",
    "overview": "108 篇 = 9 个方向 × 3 个级别。全站只有一种基本单元「章节格」，色相区分方向，深浅区分级别；首页是整张表，章节页左栏是其中一列，其余页面是这些格子的不同排法。白底、墨色文字、2px 墨线、系统无衬线字、方角。",
    "keyCharacteristics": [
      "首页 9 列 108 格一屏看全。",
      "九个方向各一个色相，级别只有浅底、中间色、实心三档。",
      "状态用记号表达：✓、墨框、透明度。",
      "没有阴影和圆角卡片，层次靠 2px 墨线、4px 方向色线和 1px 细线。",
      "章节页正文里的组件强调色跟随当前方向。"
    ],
    "rules": [
      {
        "name": "One Unit Rule",
        "body": "新页面优先用章节格排出来，不另造卡片。",
        "section": "components"
      },
      {
        "name": "Hue Is Direction, Depth Is Level",
        "body": "颜色只表达方向，深浅只表达级别，全站不出现第四档填充。",
        "section": "colors"
      },
      {
        "name": "Marks Not Hues",
        "body": "读过、当前、筛选等状态用记号，不换颜色。",
        "section": "components"
      },
      {
        "name": "Lab Canvas Exception",
        "body": "组件演示的参考画布保留已验证提示词里的色值，不随外壳换色。",
        "section": "colors"
      }
    ],
    "dos": [
      "先问能不能用章节格排出来。",
      "编号始终用全站三位编号。",
      "筛选时保持表的形状。",
      "控件才用 4px 圆角。"
    ],
    "donts": [
      "不加第四档填充。",
      "不用阴影、渐变、圆角卡片、图标方块。",
      "章节页不放全站目录树。",
      "不用颜色表达状态。",
      "不改参考画布色值。"
    ]
  }
