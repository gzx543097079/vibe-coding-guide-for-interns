  "components": [
    {
      "name": "当前任务面板",
      "kind": "panel",
      "refersTo": "desk-current",
      "description": "首页右侧显示下一步、模块、本机记录与继续按钮。",
      "html": "<aside class=\"ds-current\"><h2>接着做</h2><h3>代码规范与工程素养</h3><p>起步 · 基础</p><button>打开当前任务</button></aside>",
      "css": ".ds-current{padding:26px;border:1px solid var(--rule-strong,#bfc8bd);border-radius:8px;background:var(--raised,#fff);box-shadow:var(--shadow-2);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-current h2{font-size:17px;font-weight:680;}.ds-current h3{margin:22px 0 6px;font-size:23px;font-weight:680;}.ds-current p{color:var(--accent-ink,#1d6048);font-size:12px;}.ds-current button{min-height:43px;width:100%;border:0;border-radius:5px;background:var(--accent,#246b51);color:var(--on-accent,#fff);font:640 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}"
    },
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "action-primary",
      "description": "命名具体动作，不用悬停位移替代状态。",
      "html": "<button class=\"ds-btn-primary\">打开当前任务</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:42px;padding:0 18px;border:1px solid transparent;border-radius:5px;background:var(--accent,#246b51);color:var(--on-accent,#fff);font:640 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-btn-primary:hover{background:var(--accent-hover,#1a563f);}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#246b51);outline-offset:4px;}"
    },
    {
      "name": "任务简报",
      "kind": "form",
      "refersTo": "task-composer",
      "description": "左侧字段、右侧实时简报；复制失败时给出手动选择提示。",
      "html": "<section class=\"ds-composer\"><form><label>目标<input placeholder=\"修复登录页密码含空格时校验失败\"></label></form><pre>任务：修 bug\n目标：…\n验收标准：…</pre></section>",
      "css": ".ds-composer{display:grid;grid-template-columns:.96fr 1.04fr;border:1px solid var(--rule-strong,#bfc8bd);border-radius:8px;background:var(--raised,#fff);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-composer form{padding:25px 28px;border-right:1px solid var(--rule,#dce1da);}.ds-composer input{width:100%;padding:9px 11px;border:1px solid var(--rule-strong,#bfc8bd);border-radius:5px;background:var(--paper,#f4f5f3);font:12px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-composer input:focus{border-color:var(--accent,#246b51);box-shadow:0 0 0 2px var(--accent-soft,#e1eee7);}.ds-composer pre{padding:16px;white-space:pre-wrap;font:11px/1.85 -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}"
    },
    {
      "name": "粘性任务条",
      "kind": "toolbar",
      "refersTo": "reader-taskbar",
      "description": "阅读页滚动时保留当前任务、动手验证与完成标记。",
      "html": "<div class=\"ds-taskbar\"><span>当前任务</span><strong>起步 / 代码规范</strong><a>动手验证</a><button aria-pressed=\"false\">标记完成</button></div>",
      "css": ".ds-taskbar{position:sticky;top:66px;display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:52px;padding:8px 14px;border:1px solid var(--rule-strong,#bfc8bd);border-radius:6px;background:var(--raised,#fff);box-shadow:var(--shadow-1);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-taskbar span{font-size:9px;color:var(--ink-3,#68726b);}.ds-taskbar strong{font-size:12px;}.ds-taskbar button{min-height:32px;padding:0 11px;border:1px solid var(--accent,#246b51);border-radius:4px;background:var(--accent,#246b51);color:var(--on-accent,#fff);font:620 11px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-taskbar button[aria-pressed=\"true\"]{background:var(--tip-soft,#e1eee7);color:var(--tip,#246b51);}"
    },
    {
      "name": "工作区入口流",
      "kind": "nav",
      "refersTo": "desk-flow",
      "description": "首页紧接当前任务出现的四个领域入口：准备、协作、界面、质量。",
      "html": "<section class=\"ds-desk-flow\" aria-label=\"工作区入口\"><div class=\"ds-flow-label\"><strong>按任务进入工作区</strong><span>当前问题属于哪一段，就从哪一段开始</span></div><ol class=\"ds-stage-list\"><li><a href=\"#start\"><span>01</span><strong>准备</strong><small>环境与工程习惯</small></a></li><li><a href=\"#ai\"><span>02</span><strong>协作</strong><small>上下文与任务拆解</small></a></li><li><a href=\"#controls\"><span>03</span><strong>界面</strong><small>控件与交互实现</small></a></li><li><a href=\"#quality\"><span>04</span><strong>质量</strong><small>验证、审查与发布</small></a></li></ol></section>",
      "css": ".ds-desk-flow{display:grid;grid-template-columns:215px minmax(0,1fr);gap:36px;align-items:center;min-height:104px;border-block:1px solid var(--rule,#dce1da);background:var(--raised,#fff);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Hiragino Sans GB\",\"Noto Sans SC\",\"Noto Sans CJK SC\",\"Source Han Sans SC\",\"Microsoft YaHei\",sans-serif;}.ds-flow-label strong{display:block;font-size:14px;font-weight:670;}.ds-flow-label span{display:block;margin-top:8px;color:var(--ink-3,#68726b);font-size:11px;line-height:1.6;}.ds-stage-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;list-style:none;}.ds-stage-list li+li{border-left:1px solid var(--rule,#dce1da);}.ds-stage-list a{display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:10px;align-items:center;padding:17px 14px;color:var(--ink,#161b18);text-decoration:none;}.ds-stage-list a:hover{background:var(--paper-2,#eceeea);}.ds-stage-list a:focus-visible{outline:2px solid var(--focus,#246b51);outline-offset:-2px;}.ds-stage-list a>span{grid-row:1 / span 2;color:var(--ink-3,#68726b);font:10px ui-monospace,\"SF Mono\",Menlo,monospace;}.ds-stage-list strong{display:block;font-size:13px;font-weight:650;}.ds-stage-list small{display:block;margin-top:5px;color:var(--ink-3,#68726b);font-size:10px;white-space:nowrap;}"
    },
    {
      "name": "工作区列表",
      "kind": "list",
      "refersTo": "workspace-row",
      "description": "工作区目录用紧凑表格化行代替同尺寸卡片墙。",
      "html": "<a class=\"ds-workspace\"><span>01</span><strong>起步</strong><small>装好开发环境，了解 AI 能做什么</small><em>5 步</em></a>",
      "css": ".ds-workspace{display:grid;grid-template-columns:34px 26px minmax(0,1fr) 52px;align-items:center;gap:16px;min-height:86px;padding:15px 16px;border-bottom:1px solid var(--rule,#dce1da);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-workspace:hover{background:var(--raised,#fff);}.ds-workspace strong{font-size:14px;font-weight:660;}.ds-workspace small{color:var(--ink-3,#68726b);font-size:11px;}.ds-workspace em{color:var(--ink-3,#68726b);font-size:10px;font-style:normal;}"
    },
    {
      "name": "阅读收尾",
      "kind": "checklist",
      "refersTo": "reading-next",
      "description": "三步收尾把验证、检查与完成记录放在同一处。",
      "html": "<section class=\"ds-next\"><h2>把这一步收尾</h2><ol><li>动手试一次</li><li>对照验收</li><li>记下完成</li></ol></section>",
      "css": ".ds-next{border:1px solid var(--rule-strong,#bfc8bd);border-radius:7px;background:var(--raised,#fff);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-next h2{padding:20px 22px 16px;border-bottom:1px solid var(--rule,#dce1da);font-size:17px;}.ds-next ol{display:grid;grid-template-columns:repeat(3,1fr);margin:0;padding:0;list-style:none;}.ds-next li{min-height:112px;padding:19px 18px;font-size:13px;}.ds-next li+li{border-left:1px solid var(--rule,#dce1da);}"
    },
    {
      "name": "命令面板",
      "kind": "overlay",
      "refersTo": "command-palette",
      "description": "空查询显示最近停留与快捷动作；全文搜索是显式动作。",
      "html": "<dialog class=\"ds-palette\"><input placeholder=\"输入任务或章节名\"><div role=\"listbox\"><p>最近停留</p><div aria-selected=\"true\">接着读 · 代码规范</div></div></dialog>",
      "css": ".ds-palette{width:min(640px,100%);border:1px solid var(--rule-strong,#bfc8bd);border-radius:7px;background:var(--paper,#f4f5f3);box-shadow:var(--shadow-3);font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-palette::before{content:\"\";display:block;height:3px;background:var(--shell,#17211c);}.ds-palette input{height:56px;border:0;background:transparent;font:16px -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Noto Sans CJK SC', 'Source Han Sans SC', 'Microsoft YaHei', sans-serif;}.ds-palette [aria-selected=\"true\"]{background:var(--paper-2,#eceeea);box-shadow:inset 3px 0 0 var(--accent,#246b51);}"
    }
  ],
  "narrative": {
    "northStar": "工程交付台：一张能继续工作的桌面",
    "overview": "深灰绿工作栏固定当前位置，浅暖灰画布承载任务与正文。界面用紧凑面板、列表和状态条组织真实操作；首页恢复当前任务，阅读页保留下一步，验证台让动手检查先于复制提示词。视觉个性来自一致的信息密度、明确的当前态和克制的绿色状态色，而非海报标题、课程卡片墙或装饰拟物。",
    "keyCharacteristics": [
      "深灰绿工作栏与浅暖灰画布形成稳定的工作场景。",
      "绿色只用于当前任务、完成状态和主要动作，不铺满页面。",
